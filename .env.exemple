POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=healthbook_db
DATABASE_URL=postgresql://postgres:postgres@healthbook-db:5432/healthbook_db?schema=public

# MinIO object storage for post media.
# MINIO_ENDPOINT        : server-side endpoint reachable from the API container.
# MINIO_PUBLIC_ENDPOINT : public ingress (nginx) used to sign GET URLs handed to
#                         clients. Presigned URLs are served at /<bucket>/... via
#                         the reverse proxy; the SigV4 signature is bound to this
#                         host, so it must match what the client actually calls.
#                         Staging: https://healthai.chomizzz.fr
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:8080
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=healthbook
# Presigned URL lifetime in seconds (default 900 = 15 min).
MINIO_PRESIGN_TTL=900